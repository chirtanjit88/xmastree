{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "xmastree/promo-banner",
  "title": "Christmas Promo CTA Banner",
  "description": "Rounded dark feature banner panel with configurable background image, optional gradient overlay, uppercase serif heading, supporting copy, and crimson pill CTA button.",
  "category": "xmastree-blocks",
  "icon": "megaphone",
  "keywords": [
    "promo banner",
    "cta banner",
    "mas corner",
    "decorations",
    "gifts",
    "banner",
    "xmastree"
  ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  },
  "supports": {
    "anchor": true,
    "align": [
      "full",
      "wide"
    ],
    "html": false,
    "jsx": true
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}
