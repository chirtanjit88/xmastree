{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "xmastree/photo-gallery",
  "title": "Photo Gallery (Lightbox)",
  "description": "Responsive multi-column photo gallery grid where clicking any image opens a full-screen interactive lightbox viewer with keyboard, swipe, and thumbnail navigation.",
  "category": "xmastree-blocks",
  "icon": "format-gallery",
  "keywords": [
    "gallery",
    "photos",
    "lightbox",
    "images",
    "grid",
    "popup",
    "xmastree"
  ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  },
  "supports": {
    "anchor": true,
    "align": [
      "full",
      "wide"
    ],
    "html": false,
    "jsx": true
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "viewScript": "file:./view.js"
}

