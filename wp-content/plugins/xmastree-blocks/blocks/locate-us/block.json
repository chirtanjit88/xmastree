{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "xmastree/locate-us",
  "title": "Locate Us",
  "description": "Locate Us split section with dark green locations list panel and right-side photo card.",
  "category": "xmastree-blocks",
  "icon": "location",
  "keywords": [
    "locate us",
    "locations",
    "map",
    "directions",
    "hours",
    "xmastree"
  ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  },
  "supports": {
    "anchor": true,
    "align": [
      "full",
      "wide"
    ],
    "html": false,
    "jsx": true
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}

