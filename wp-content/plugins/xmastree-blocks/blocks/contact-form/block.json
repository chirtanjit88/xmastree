{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "xmastree/contact-form",
  "title": "Contact Form & Photo",
  "description": "Two-column contact section pairing a Forminator shortcode form panel (heading, subtitle, styled Forminator form) with a rounded feature photograph.",
  "category": "xmastree-blocks",
  "icon": "email-alt",
  "keywords": [
    "contact",
    "form",
    "forminator",
    "shortcode",
    "inquiry",
    "message",
    "photo",
    "xmastree"
  ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  },
  "supports": {
    "anchor": true,
    "align": [
      "full",
      "wide"
    ],
    "html": false,
    "jsx": true
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}

