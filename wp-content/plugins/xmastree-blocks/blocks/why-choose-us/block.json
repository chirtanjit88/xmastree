{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "xmastree/why-choose-us",
  "title": "Why Choose Us",
  "description": "Why Families Choose Us section with image card and animated feature cards.",
  "category": "xmastree-blocks",
  "icon": "heart",
  "keywords": [
    "why choose us",
    "features",
    "family",
    "tradition",
    "xmastree"
  ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  },
  "supports": {
    "anchor": true,
    "align": [
      "full",
      "wide"
    ],
    "html": false,
    "jsx": true
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}

