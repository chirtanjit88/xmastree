{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "xmastree/monterey-pine-banner",
  "title": "Monterey Pine Banner",
  "description": "Full-bleed video/image banner section showcasing the Monterey Pine variety, CTA button, and price callout.",
  "category": "xmastree-blocks",
  "icon": "format-video",
  "keywords": [
    "monterey",
    "pine",
    "video",
    "banner",
    "price",
    "xmastree"
  ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  },
  "supports": {
    "anchor": true,
    "align": [
      "full",
      "wide"
    ],
    "html": false,
    "jsx": true
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}

